<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug installs as a separate .dev app, so give it its own names to tell it apart from the
    Play Store install. The dev strings aren't translated, so these show in every locale.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:label="@string/app_name_dev"
        tools:replace="android:label">
        <activity
            android:name=".SplashActivity"
            android:label="@string/app_name_icon_dev"
            tools:replace="android:label" />
    </application>
</manifest>
